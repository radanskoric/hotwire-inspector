{
  "name": "hotwire-inspector",
  "description": "Hotwire Inspector - Devtools extension for the Hotwire powered frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:debug": "WXT_DEBUG_BUILD=true wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari",
    "test": "vitest",
    "test:all": "node scripts/test-all.js",
    "coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.js --project=chromium",
    "test:e2e:hybrid": "playwright test -c tests/e2e/playwright.config.js",
    "test:e2e:firefox": "playwright test -c tests/e2e/playwright.firefox.config.js",
    "test:e2e:headed": "playwright test -c tests/e2e/playwright.config.js --headed",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.13.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "tom-select": "^2.6.2"
  }
}
